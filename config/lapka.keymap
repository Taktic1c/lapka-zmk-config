#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define GAM 1
#define GFN 2
#define NAV 3
#define SYM 4
#define NUM 5

&sk { release-after-ms = <60000>; };

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp Q  &kp W           &kp E               &kp R             &kp T      &kp Y      &kp U              &kp I                &kp O            &kp P
&kp A  &mt LEFT_ALT S  &mt LEFT_CONTROL D  &mt LEFT_SHIFT F  &kp G      &kp H      &mt RIGHT_SHIFT J  &mt RIGHT_CONTROL K  &mt RIGHT_ALT L  &kp SEMI
&kp Z  &kp X           &kp C               &kp V             &kp B      &kp N      &kp M              &kp COMMA            &kp DOT          &kp FSLH
                       &kp LEFT_CONTROL    &mo 1             &kp SPACE  &kp SPACE  &mo 2              &kp RALT
            >;
        };

        Navigate {
            bindings = <
&kp ESCAPE      &kp TAB       &kp PAGE_UP       &kp PAGE_DOWN   &kp TILDE   &none            &none     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSPACE
&kp LEFT_WIN    &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp ENTER   &kp PRINTSCREEN  &kp LEFT  &kp UP_ARROW      &kp RIGHT          &kp DOUBLE_QUOTES
&studio_unlock  &none         &mkp RCLK         &mkp LCLK       &kp DELETE  &none            &kp HOME  &kp DOWN          &kp END            &kp DELETE
                              &none             &trans          &none       &kp ENTER        &mo 3     &trans
            >;
        };

        Symbols {
            bindings = <
&kp N1        &kp N2         &kp N3        &kp N4         &kp N5     &kp N6     &kp N7     &kp N8        &kp N9        &kp N0
&kp SEMI      &kp RA(GRAVE)  &kp GRAVE     &kp LS(GRAVE)  &kp MINUS  &kp PLUS   &sk RSHFT  &sk RCTRL     &sk LALT      &sk RGUI
&kp RA(BSLH)  &none          &kp LS(LBKT)  &kp LBKT       &kp UNDER  &kp EQUAL  &kp RBKT   &kp LS(RBKT)  &kp LS(BSLH)  &kp BSLH
                             &trans        &mo 3          &kp ENTER  &none      &trans     &none
            >;
        };

        Functional {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR_ALL
&kp F6  &kp F7  &kp F8  &kp F9   &kp F10  &none         &none         &none         &none         &none
&none   &none   &none   &kp F11  &kp F12  &kp KP_NUM    &none         &none         &sys_reset    &bootloader
                &none   &trans   &trans   &trans        &trans        &none
            >;
        };

        nav_layer {
            bindings = <
&sk LC(TAB)       &sk LA(TAB)        &sk LG(TAB)  &none      &kp ESC  &kp ESC  &kp HOME   &kp END    &kp BSPC  &kp DEL
&sk LGUI          &sk LALT           &sk LCTRL    &sk LSHFT  &kp RET  &kp RET  &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT
&kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &tog 1       &kp PSCRN  &kp TAB  &kp TAB  &kp PG_UP  &kp PG_DN  &kp APOS  &kp KP_NUM
                                     &trans       &trans     &trans   &trans   &trans     &trans
            >;
        };

        num_layer {
            bindings = <
&kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_N0
&sk LGUI   &sk LALT   &sk LCTRL  &sk LSHFT  &kp F11    &kp F12    &sk RSHFT  &sk RCTRL  &sk LALT   &sk RGUI
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10
                      &trans     &trans     &trans     &trans     &trans     &trans
            >;
        };
    };
};
